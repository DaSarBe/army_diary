        { "who": "小林", "text": "連長，我這邊雜訊很大。我先找地方架。" },
        { "who": "黃連長", "text": "收到。敵人一律當不明敵軍。不要假設他們會停手。" }
      ]
    },
    "tutorial_intro": {
      "lines": [
        { "who": "小林", "text": "老方，沙包後面。蹲低。這個我們都做過，手還記得就好。" }
      ]
