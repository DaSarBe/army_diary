  "scenes": {
    "boat_chat": {
      "checkpoint": true,
      "lines": [
        { "who": "小林", "text": "老方，你有沒有覺得，我們的年紀比班長還大？" },
        { "who": "小林", "text": "這條線頭我檢查第三次了。不是不信任工廠，是手自己停不下來。" },
        { "who": "後備兵甲", "text": "誰的肚子比較大？我先講，我從退伍就沒再跑過三千公尺。" },
        { "who": "後備兵乙", "text": "你那叫三千公尺？那叫走到超商。" }
      ],
      "choices": [
        { "id": "age", "text": "「班長現在才比較像班長。」", "flag": "isl_chat_lin_ok" },
        { "id": "quiet", "text": "「先把槍擦乾。海風會咬。」", "flag": "isl_chat_quiet" },
        { "id": "wang", "text": "「王班長在島上。我是來找人的。」", "flag": "isl_chat_wang" }
      ]
    },
