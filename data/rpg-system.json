  "balance": {
    "_desc": "平衡原則與預期數值走向。",
    "startingStats": "沿用四種背景（uni/office/site/gamer）的初始值，總和 170 到 195。",
    "expectedEndTotal": "認真玩約 230 到 260，隨便玩約 190 到 215，常犯錯約 150 到 180。",
    "rules": [
      "單一選項或任務對單一屬性最多 +4，總和最多 +8。",
      "每章至少有 2 個會扣分的失敗後果，扣分幅度要和加分相當。",
